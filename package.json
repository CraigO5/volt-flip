{
  "name": "volt-flip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/game.test.mjs tests/notes.test.mjs tests/marking-menu.test.mjs tests/solver.test.mjs tests/solver-planner.test.mjs",
    "benchmark:solver": "node scripts/benchmark-strategies.mjs --boards=2000 --workers=3 --out=qa/strategy-benchmark.json && node scripts/render-strategy-report.mjs",
    "build:pages": "vite build"
  },
  "dependencies": {
    "@fontsource/bree-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0"
  }
}
